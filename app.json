{
  "expo": {
    "name": "3nan",
    "slug": "3nan",
    "version": "1.0.0",
    "scheme": "3nan",
    "orientation": "portrait",
    "icon": "./assets/icons/3nan-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.3nan.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/3nan-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.3nan.app"
    },
    "web": {
      "favicon": "./assets/icons/3nan-icon.png",
      "bundler": "metro"
    }
  }
}
