{
  "expo": {
    "name": "3nan",
    "slug": "3nan",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "scheme": "3nan",
    "orientation": "portrait",
    "icon": "./assets/icons/3nan-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.threenan.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/3nan-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.threenan.app"
    },
    "web": {
      "favicon": "./assets/icons/3nan-icon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow access to Face ID for secure storage"
        }
      ]
    ]
  }
}
